# Server-only. Copy the Transaction Pooler URI from Supabase Dashboard → Connect.
# Use the Transaction Pooler URL (port 6543) and replace its password placeholder locally.
# Never prefix this variable with VITE_ or commit a real connection string.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Existing phone auth is still active until the Supabase email-auth change is completed.
MINIMOTH_API_KEY=mm_test_your_key_here

# Optional server-only assistant providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
